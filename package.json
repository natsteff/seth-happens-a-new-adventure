{
  "name": "seth-happens-a-new-adventure",
  "version": "0.17.2",
  "private": true,
  "type": "module",
  "scripts": {
    "scores:server": "node server/app.mjs",
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.mjs",
    "test:firebase": "firebase emulators:exec --only auth,firestore --project demo-seth-happens-2 \"node --test tests/firebase-rules.emulator.mjs\"",
    "scores:initialize": "node scripts/initialize-scoreboards.mjs --project=seth-happens-2"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@11.25.0",
  "dependencies": {
    "firebase": "^13.2.0",
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "fake-indexeddb": "^6.2.7",
    "firebase-tools": "^15.35.0",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
